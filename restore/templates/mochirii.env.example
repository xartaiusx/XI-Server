# Copy this to a local, ignored environment file when restoring Mochirii.
# Do not commit real passwords or passphrase paths.

MOCHIRII_DB_HOST=127.0.0.1
MOCHIRII_DB_PORT=3306
MOCHIRII_DB_NAME=xidb
MOCHIRII_DB_USER=xi
MOCHIRII_DB_PASSWORD=change-me
MOCHIRII_ZONE_IP=127.0.0.1
MOCHIRII_RUNTIME_ROOT=$HOME/FFXI-Runtime
MOCHIRII_WINE_PREFIX=$HOME/.local/share/mochirii/wine
